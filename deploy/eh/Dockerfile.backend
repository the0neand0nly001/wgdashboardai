FROM node:22-bookworm-slim AS ui
WORKDIR /build
COPY src/static/app/package*.json ./
RUN npm ci --ignore-scripts
COPY src/static/app ./
RUN npm run build

FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends wireguard-tools iproute2 iptables iputils-ping traceroute && rm -rf /var/lib/apt/lists/*
WORKDIR /app/src
COPY src/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY src /app/src
COPY --from=ui /dist/WGDashboardAdmin /app/src/static/dist/WGDashboardAdmin
COPY deploy/eh /app/deploy/eh
ENV CONFIGURATION_PATH=/data TZ=Europe/Dublin
CMD ["python", "/app/deploy/eh/backend_start.py"]
